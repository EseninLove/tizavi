{
  "name": "tizavi-shop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Telegram Mini App для интернет-магазина",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc --noEmit -p api/tsconfig.json",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write src api tests README.md vercel.json"
  },
  "dependencies": {
    "pg": "^8.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^20.16.10",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vercel/node": "^28.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@vercel/node": {
      "undici": "^6.29.1",
      "path-to-regexp": "^6.3.0"
    },
    "@vercel/static-config": {
      "ajv": "^8.20.0"
    },
    "@fastify/busboy": "^3.2.4"
  }
