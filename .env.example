# Server only: never prefix payment or address keys with VITE_.
DB_URL=
BOT_TOKEN=
ADMIN_KEY=
PUBLIC_APP_URL=https://your-shop.example
# Optional dedicated encryption key, 32 random bytes in hexadecimal.
# Otherwise a separate encryption key is derived from server-only BOT_TOKEN.
PAYMENT_SETTINGS_KEY=
# Optional alternative: credentials supplied by deployment settings.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
YOOKASSA_ALLOW_TEST=false
SUBSCRIPTION_PRICE_RUB=199
SUBSCRIPTION_DAYS=30
# Address suggestions / house coordinates. Optional until delivery is enabled.
DADATA_TOKEN=
